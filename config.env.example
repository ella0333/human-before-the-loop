# Reference copy of what setup.py writes. You do not need to edit this file.
#
#   python setup.py
#
# That prompts for each value, writes config.env beside this file, and then
# checks every credential against its live service so you find out now rather
# than mid-run. config.env is git-ignored.
#
# To fill it in by hand instead, copy this file to config.env and edit it, then
# run `python setup.py --check` to verify.
#
# To override one value for a single evaluation, put a .env in that evaluation's
# harness/ directory. It wins over this file.


# --------------------------------------------- required by every evaluation

# OpenRouter API key. Every model call in every evaluation goes through it.
# https://openrouter.ai -> Keys -> Create. Set a credit limit on the key: the
# harnesses treat that limit as the hard stop on model spend and pause rather
# than overspend.
OPENROUTER_API_KEY=

# Docker must be installed and running. Each evaluation builds its own
# container image and starts and removes the container itself.


# ------------------------------------------ required by section 5 GAIA only

# Bounded public-web search and page extraction, used by both arms of the GAIA
# suite. No other evaluation reaches the live web. https://tavily.com -> API Keys.
TAVILY_API_KEY=

# The GAIA suite also needs a HuggingFace login, because the benchmark is a
# gated dataset. There is no key to put here: create an account, accept the
# terms at https://huggingface.co/datasets/gaia-benchmark/GAIA (granted
# instantly), then run `huggingface-cli login` once on this machine.


# ------------------------------------ required by section 6 capability only

# Path to your own legally obtained Pokemon Red (USA, Europe) .gb ROM.
# Red specifically, not Blue or Yellow: the finish condition reads Red's Pokedex
# event bit out of emulator memory. This is the only file you have to supply;
# the emulator, the Lua scripts and the map database are in the repository.
# Example: C:\roms\PokemonRed.gb   or   /home/you/roms/PokemonRed.gb
LOCAL_ROM_PATH=


# ---------------------------------------------------------------- optional

# Seconds to wait for a cold container to finish starting. Raise it only if the
# startup log is still making progress when it times out.
GATEWAY_START_TIMEOUT=900

