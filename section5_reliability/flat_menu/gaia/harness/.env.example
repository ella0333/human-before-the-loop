# Copy to .env and fill in. .env is git-ignored and never leaves this machine.
# Only the OpenRouter and Tavily evaluation keys are passed to the container.
# Root-only copies support the SSH-launched constrained runner.

# OpenRouter model sessions. openrouter.ai -> Keys -> Create.
OPENROUTER_API_KEY=sk-or-...

# Blinded semantic completion judge (provider is pinned to OpenAI in code).
JUDGE_MODEL=openai/gpt-5.6-luna

# Optional legacy synthetic run. Successful full runs automatically combine it.
LEGACY_RUN_DIR=

# Bounded public-web search and extraction for both experimental arms.
TAVILY_API_KEY=tvly-...

# A cold container can take several minutes to finish stable OpenClaw's
# one-time onboarding before Gateway starts. Increase only if startup logs show
# continued progress; this does not affect per-session model timeouts.
GATEWAY_START_TIMEOUT=900

# Optional. Seconds allowed per session before the orchestrator gives up on it.
#SESSION_TIMEOUT=900

# NOTE: model slugs are NOT configured here. They live in evalspec.py, which is the
# single source of truth shared by the corpus builder, the runner, and the classifier.
